{
  "manifest_version": 3,
  "name": "이슈 모니터링 보고서 작성",
  "version": "1.0.17",
  "description": "언론(네이버 뉴스)·동호회(네이버 카페)·유튜브·자동차 커뮤니티에서 이슈 키워드 게시글과 댓글을 모아 AI로 관련성·성향(긍정/중립/부정/단순비난)을 판독하고, 엑셀과 여론 동향 PPT 보고서를 만들어 DB로 보관합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "이슈 모니터링 보고서 작성",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "cookies",
    "storage",
    "unlimitedStorage",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.naver.com/*",
    "https://naver.me/*",
    "https://www.youtube.com/*",
    "https://www.bobaedream.co.kr/*",
    "https://m.bobaedream.co.kr/*",
    "https://www.clien.net/*",
    "https://www.ppomppu.co.kr/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cafe.naver.com/*"
      ],
      "js": [
        "bg-render.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
