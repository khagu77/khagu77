{
  "manifest_version": 3,
  "name": "'현대차 위기론' 관련 부정적 프레임의 유튜브 콘텐츠 모니터링",
  "version": "1.1.4",
  "description": "관리 채널·주요 경제 채널과 유튜브 검색에서 '현대차 위기론' 부정 프레임 콘텐츠를 모아 일자별 발행 추이 대시보드·DB·썸네일 포함 엑셀로 정리합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "'현대차 위기론' 유튜브 콘텐츠 모니터링",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://api.anthropic.com/*"
  ],
  "key": ""
}
