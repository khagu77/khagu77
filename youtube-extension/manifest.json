{
  "manifest_version": 3,
  "name": "YouTube 스크립트 및 영상 파일 추출",
  "version": "1.17.0",
  "description": "유튜브 영상 URL을 넣으면 들리는 말(음성 인식)이나 화면 하단 자막(화면 자막 인식)으로 '00:00 스크립트' 텍스트를 만들거나, 영상을 .mp4 영상 파일이나 .mp3 음성 파일로 저장합니다.",
  "key": "",
  "action": {
    "default_title": "YouTube 스크립트 및 영상 파일 추출"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "downloads",
    "nativeMessaging",
    "declarativeNetRequest",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
