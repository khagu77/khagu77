{
  "manifest_version": 3,
  "name": "GV90(JG1) 온라인 게시물 일일 수집",
  "version": "1.6.3",
  "description": "언론(네이버 뉴스)·동호회(네이버 카페)·유튜브·자동차 커뮤니티에서 매일 GV90 관련 게시물을 모아 커뮤니티명·차종·게시일·구분·URL·주요 내용·성향(긍정/중립/부정/단순비난)을 raw data 엑셀로 저장하고, 데일리 DB·대시보드로 보관합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GV90(JG1) 온라인 게시물 일일 수집",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "scripting",
    "cookies",
    "storage",
    "unlimitedStorage",
    "downloads",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.naver.com/*",
    "https://naver.me/*",
    "https://www.youtube.com/*",
    "https://www.bobaedream.co.kr/*",
    "https://m.bobaedream.co.kr/*",
    "https://www.clien.net/*",
    "https://www.ppomppu.co.kr/*",
    "https://m.ppomppu.co.kr/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cafe.naver.com/*"
      ],
      "js": [
        "bg-render.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
