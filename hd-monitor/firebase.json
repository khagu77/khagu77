{
  "hosting": [
    {
      "target": "hdmon",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/ingest",
          "function": {
            "functionId": "ingestExternal",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "hdmon",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.log"
      ]
    }
  ],
  "firestore": [
    {
      "database": "hdmon",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ]
}
