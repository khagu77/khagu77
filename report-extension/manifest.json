{
  "manifest_version": 3,
  "name": "온라인 오전동향 PPT 보고서 작성기",
  "version": "1.9.0",
  "description": "일일 부정 이슈 엑셀에서 + 표시된 카페 게시물을 캡처·요약해 현대차 온라인 이슈 보고서(.pptx)를 만듭니다.",
  "action": {
    "default_title": "온라인 오전동향 PPT 보고서 작성기"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://cafe.naver.com/*",
    "https://m.cafe.naver.com/*",
    "https://naver.me/*",
    "https://*.naver.com/*",
    "https://*.pstatic.net/*",
    "https://api.anthropic.com/*"
  ]
}
